{
  "name": "sistem-koperasi-offline",
  "version": "1.0.0",
  "description": "Sistem Akuntansi Koperasi Berbasis Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.koperasi.sistem",
    "productName": "Sistem Koperasi",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      "php/**/*",
      "sistem/**/*",
      "publik/**/*",
      "vendor/**/*",
      "panduan/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}